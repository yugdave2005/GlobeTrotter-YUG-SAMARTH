generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  passwordHash        String?  @map("password_hash")
  name                String
  photoUrl            String?  @map("photo_url")
  languagePreference  String   @default("en") @map("language_preference")
  role                Role     @default(USER)
  googleId            String?  @unique @map("google_id")
  resetOtp            String?  @map("reset_otp")
  resetOtpExpires     DateTime? @map("reset_otp_expires")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  
  savedDestinations   SavedDestination[]
  trips               Trip[]
  preferences         TravelPreference?

  @@map("users")
}

model TravelPreference {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  interests       String[]
  travelStyle     String   @map("travel_style")
  travelPace      String   @map("travel_pace")
  budget          String
  companions      String
  priorities      String[]
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("travel_preferences")
}

enum Role {
  USER
  ADMIN
}

model SavedDestination {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  cityId    String   @map("city_id")
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  
  @@map("saved_destinations")
}

model City {
  id              String   @id @default(uuid())
  name            String
  country         String
  region          String
  costIndex       Float    @map("cost_index")
  popularityScore Int      @map("popularity_score")
  imageUrl        String   @map("image_url")
  createdAt       DateTime @default(now()) @map("created_at")
  
  activities        Activity[]
  tripStops         TripStop[]
  savedDestinations SavedDestination[]

  @@map("cities")
}

model Activity {
  id              String   @id @default(uuid())
  cityId          String   @map("city_id")
  name            String
  category        ActivityCategory
  cost            Float
  durationMinutes Int      @map("duration_minutes")
  description     String
  imageUrl        String?  @map("image_url")
  
  city            City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  stopActivities  StopActivity[]

  @@map("activities")
}

enum ActivityCategory {
  SIGHTSEEING
  FOOD
  ADVENTURE
  RELAXATION
}

model Trip {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  description     String?
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  coverPhotoUrl   String?  @map("cover_photo_url")
  budget          Float?   @default(50000) @map("budget")
  isPublic        Boolean  @default(false) @map("is_public")
  shareSlug       String?  @unique @map("share_slug")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops           TripStop[]
  expenses        TripExpense[]

  @@map("trips")
}

model TripStop {
  id              String   @id @default(uuid())
  tripId          String   @map("trip_id")
  cityId          String   @map("city_id")
  arrivalDate     DateTime @map("arrival_date")
  departureDate   DateTime @map("departure_date")
  sortOrder       Int      @map("sort_order")
  
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city            City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  activities      StopActivity[]
  expenses        TripExpense[] 

  @@map("trip_stops")
}

model TripExpense {
  id              String   @id @default(uuid())
  tripId          String   @map("trip_id")
  tripStopId      String?  @map("trip_stop_id")
  category        ExpenseCategory
  amount          Float
  description     String
  
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripStop        TripStop? @relation(fields: [tripStopId], references: [id], onDelete: SetNull)

  @@map("trip_expenses")
}

enum ExpenseCategory {
  TRANSPORT
  STAY
  MEALS
  MISC
}

model StopActivity {
  id              String   @id @default(uuid())
  tripStopId      String   @map("trip_stop_id")
  activityId      String   @map("activity_id")
  scheduledTime   DateTime? @map("scheduled_time")
  customCost      Float?   @map("custom_cost")
  
  tripStop        TripStop @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  activity        Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("stop_activities")
}
